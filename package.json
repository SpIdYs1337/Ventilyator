{
  "name": "ventilyator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "db:generate": "pnpm --filter @ventilyator/database generate",
    "db:migrate": "pnpm --filter @ventilyator/database migrate",
    "build": "pnpm db:generate && pnpm -r --sort build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "admin:create": "pnpm --filter @ventilyator/api admin:create"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "@types/node": "26.6.5"
  }
}
