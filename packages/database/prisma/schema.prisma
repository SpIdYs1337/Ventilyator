generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  users     User[]
  roles     Role[]
  audit     AuditEvent[]
  storage   StorageObject[]
  projects  Project[]
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String   @unique
  name           String
  passwordHash   String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  roles          UserRole[]
  sessions       SessionMetadata[]
  identities     AuthIdentity[]
  audit          AuditEvent[]
  ownedProjects  Project[] @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  authoredTasks  Task[] @relation("TaskAuthor")
  assignedTasks  Task[] @relation("TaskAssignee")
  taskComments   TaskComment[]
  taskEvents     TaskEvent[]
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model AuthIdentity {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  subject   String
  @@unique([provider, subject])
}

model Role {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  permissions    RolePermission[]
  users          UserRole[]
  @@unique([organizationId, name])
}

model Permission {
  key   String @id
  roles RolePermission[]
}

model RolePermission {
  roleId     String @db.Uuid
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  grant      Permission @relation(fields: [permission], references: [key], onDelete: Restrict)
  @@id([roleId, permission])
}

model UserRole {
  userId String @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String @db.Uuid
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model SessionMetadata {
  id         String @id
  userId     String @db.Uuid
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  userAgent  String
  @@index([userId, revokedAt])
}

model AuditEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String? @db.Uuid
  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([organizationId, createdAt])
}

model StorageObject {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  state          String @default("PENDING")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  versions       StorageObjectVersion[]
  @@index([organizationId, deletedAt])
}

model StorageObjectVersion {
  id        String @id @default(uuid()) @db.Uuid
  objectId  String @db.Uuid
  object    StorageObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  number    Int
  size      BigInt
  sha256    String @db.Char(64)
  mimeType  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([objectId, number])
}

enum ProjectMemberRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TaskStatus {
  NEW
  PLANNED
  IN_PROGRESS
  REVIEW
  DONE
  CLOSED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskType {
  TASK
  BUG
  IMPROVEMENT
  REQUEST
  INCIDENT
  EPIC
  SUBTASK
}

model Project {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ownerId        String @db.Uuid
  owner          User @relation("ProjectOwner", fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  key            String @db.VarChar(12)
  name           String @db.VarChar(150)
  description    String @default("")
  archived       Boolean @default(false)
  nextTaskNumber Int @default(0)
  version        Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  members        ProjectMember[]
  tasks          Task[]
  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@index([organizationId, archived, createdAt])
}

model ProjectMember {
  projectId      String @db.Uuid
  organizationId String @db.Uuid
  project        Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId         String @db.Uuid
  user           User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  role           ProjectMemberRole @default(MEMBER)
  @@id([projectId, userId])
  @@index([userId, organizationId])
}

model Task {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  projectId      String @db.Uuid
  project        Project @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  number         Int
  title          String @db.VarChar(250)
  description    String @default("")
  type           TaskType @default(TASK)
  status         TaskStatus @default(NEW)
  priority       TaskPriority @default(NORMAL)
  authorId       String @db.Uuid
  author         User @relation("TaskAuthor", fields: [authorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId     String? @db.Uuid
  assignee       User? @relation("TaskAssignee", fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  dueAt          DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  version        Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  comments       TaskComment[]
  events         TaskEvent[]
  @@unique([projectId, number])
  @@unique([id, organizationId])
  @@index([projectId, status, createdAt])
  @@index([organizationId, assigneeId, status])
}

model TaskComment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  taskId         String @db.Uuid
  task           Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String @db.Uuid
  author         User @relation(fields: [authorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  body           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([taskId, createdAt])
}

model TaskEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  taskId         String @db.Uuid
  task           Task @relation(fields: [taskId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actorId        String @db.Uuid
  actor          User @relation(fields: [actorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  action         String
  changes        Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  @@index([taskId, createdAt])
}
