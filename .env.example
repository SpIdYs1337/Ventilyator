# Скопируйте в .env; реальные секреты создаёт infrastructure/scripts/configure.py.
APP_HOST=ventilyator.company.local
APP_ORIGIN=https://ventilyator.company.local
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT=internal
TLS_KEY=
DATA_ROOT=/srv/ventilyator
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
NODE_ENV=production
SESSION_MAX_DAYS=30
# IMAP — дополнительный способ входа; local работает независимо.
# Только implicit TLS, проверка сертификата всегда включена.
IMAP_HOST=
IMAP_PORT=993
IMAP_DOMAIN=
IMAP_ORGANIZATION_ID=
